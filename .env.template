# DIAL API Configuration
DIAL_API_KEY=your_dial_api_key_here
DIAL_API_VERSION=2024-02-01
DIAL_API_ENDPOINT=https://ai-proxy.lab.epam.com
DIAL_MODEL=gpt-4o-mini
DIAL_MAX_TOKENS=2048
DIAL_TEMPERATURE=0.3

# Embedding Model Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Vector Database Configuration
VECTOR_DB_PATH=./vector_db/
FAISS_INDEX_NAME=policy_index

# FastAPI Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true
API_DEBUG=true

# Streamlit Configuration
STREAMLIT_HOST=127.0.0.1
STREAMLIT_PORT=8501

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
LOG_ROTATION=10 MB
LOG_RETENTION=30 days

# Application Settings
APP_NAME=Hate Speech Detection System
APP_VERSION=1.0.0
ALLOWED_ORIGINS=["http://localhost:8501", "http://127.0.0.1:8501"]

# Database Configuration (Optional - for future scaling)
DATABASE_URL=sqlite:///./hate_speech_db.sqlite
# DATABASE_URL=postgresql://user:password@localhost/hate_speech_db

# Security Settings
SECRET_KEY=your_secret_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Content Moderation Thresholds
HATE_SPEECH_THRESHOLD=0.7
CONFIDENCE_THRESHOLD=0.8
MAX_TEXT_LENGTH=5000

# Policy Document Paths
POLICY_DOCS_PATH=./data/policies/
REDDIT_POLICY_PATH=./data/policies/reddit_policy.txt
META_POLICY_PATH=./data/policies/meta_policy.txt
GOOGLE_POLICY_PATH=./data/policies/google_policy.txt
INDIAN_PENAL_CODE_PATH=./data/policies/indian_penal_code.txt
US_LAWS_PATH=./data/policies/us_laws.txt